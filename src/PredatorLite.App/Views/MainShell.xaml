<UserControl
    x:Class="PredatorLite.App.Views.MainShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Padding="16,0,148,0"
            Background="{ThemeResource PredatorPaneBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
                Width="24"
                Height="24"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/PredatorLite.png" />
            <TextBlock
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Variable Display"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{ThemeResource PredatorTextBrush}"
                Text="{StaticResource App.Name}" />
            <Border
                Grid.Column="3"
                Padding="8,3"
                VerticalAlignment="Center"
                Background="{ThemeResource PredatorSurfaceSecondaryBrush}"
                CornerRadius="6">
                <TextBlock
                    Style="{StaticResource MutedTextStyle}"
                    Text="{x:Bind ViewModel.DeviceModel, Mode=OneWay}" />
            </Border>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="12,10,12,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.RebootRequired, Mode=OneWay}"
            Message="{StaticResource Status.RebootRequired}"
            Severity="Warning" />

        <NavigationView
            x:Name="Navigation"
            Grid.Row="2"
            AlwaysShowHeader="False"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="196"
            PaneDisplayMode="Auto"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{StaticResource Nav.Home}" Tag="home">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{StaticResource Nav.Lighting}" Tag="lighting">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE706;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{StaticResource Nav.Monitor}" Tag="monitor">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{StaticResource Nav.Settings}" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Border
            Grid.Row="3"
            Background="{ThemeResource PredatorPaneBrush}"
            BorderBrush="{ThemeResource PredatorBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid Padding="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Ellipse
                    Width="8"
                    Height="8"
                    Margin="0,0,9,0"
                    Fill="{ThemeResource PredatorAccentBrush}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource PredatorMutedTextBrush}"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource MutedTextStyle}"
                    Text="{x:Bind ViewModel.BiosVersion, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
