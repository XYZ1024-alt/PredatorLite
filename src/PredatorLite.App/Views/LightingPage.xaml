<Page
    x:Class="PredatorLite.App.Views.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1080" Padding="28,22,28,32" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{StaticResource Page.Lighting}" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{StaticResource Section.LightingEffect}" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource SectionPanelStyle}">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{StaticResource Section.LightingEffect}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="{StaticResource Label.Effect}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="18">
                        <ComboBox
                            Width="260"
                            HorizontalAlignment="Left"
                            IsEnabled="{x:Bind ViewModel.LightingAvailable, Mode=OneWay}"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind ViewModel.LightingEffects}"
                            SelectedValue="{x:Bind ViewModel.SelectedLightingEffect, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{StaticResource Label.Brightness}" />
                                <Slider IsEnabled="{x:Bind ViewModel.LightingAvailable, Mode=OneWay}" Minimum="0" Maximum="5" StepFrequency="1" TickFrequency="1" Value="{x:Bind ViewModel.LightingBrightness, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{StaticResource Label.AnimationSpeed}" />
                                <Slider IsEnabled="{x:Bind ViewModel.LightingAvailable, Mode=OneWay}" Minimum="1" Maximum="5" StepFrequency="1" TickFrequency="1" Value="{x:Bind ViewModel.LightingSpeed, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="7">
                                <TextBlock Text="{StaticResource Label.Direction}" />
                                <ComboBox Width="130" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.LightingAvailable, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.LightingDirections}" SelectedItem="{x:Bind ViewModel.LightingDirection, Mode=TwoWay}" />
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="7">
                                    <TextBlock Text="{StaticResource Label.PrimaryColor}" />
                                    <Button
                                        IsEnabled="{x:Bind ViewModel.LightingAvailable, Mode=OneWay}"
                                        Style="{StaticResource ColorSwatchButtonStyle}"
                                        Background="{x:Bind ViewModel.LightingPrimaryColor, Mode=OneWay, Converter={StaticResource HexColorToBrushConverter}}"
                                        Command="{x:Bind ViewModel.PickPrimaryColorCommand}"
                                        ToolTipService.ToolTip="{StaticResource Tip.PickColor}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Header="{StaticResource Label.LogoLighting}" IsEnabled="{x:Bind ViewModel.LightingAvailable, Mode=OneWay}" IsOn="{x:Bind ViewModel.LogoLightingEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource SectionPanelStyle}">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{StaticResource Section.StaticZones}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="{StaticResource Tip.PickColor}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="18">
                        <ItemsControl IsEnabled="{x:Bind ViewModel.LightingAvailable, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.LightingZones}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="112"
                                        Height="82"
                                        Padding="8"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Bottom"
                                        Background="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                        BorderBrush="{ThemeResource PredatorBorderBrush}"
                                        BorderThickness="1"
                                        Click="ZoneColor_Click"
                                        CornerRadius="8">
                                        <Border Padding="7,3" HorizontalAlignment="Left" Background="#B0101416" CornerRadius="5">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Foreground="White" Text="{StaticResource Label.Zone}" />
                                                <TextBlock Foreground="White" Text="{Binding Index}" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button HorizontalAlignment="Right" IsEnabled="{x:Bind ViewModel.LightingAvailable, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Content="{StaticResource Action.Apply}" Command="{x:Bind ViewModel.ApplyLightingCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
