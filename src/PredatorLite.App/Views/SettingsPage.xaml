<Page
    x:Class="PredatorLite.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1080" Padding="28,22,28,32" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{StaticResource Page.Settings}" />
                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{StaticResource App.Name}" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource SectionPanelStyle}">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{StaticResource Section.Application}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="{StaticResource Label.Language}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton Content="中文" GroupName="Language" IsChecked="{x:Bind ViewModel.CurrentLanguage, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=zh-CN}" Command="{x:Bind ViewModel.ChangeLanguageCommand}" CommandParameter="zh-CN" />
                            <RadioButton Content="English" GroupName="Language" IsChecked="{x:Bind ViewModel.CurrentLanguage, Mode=OneWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=en-US}" Command="{x:Bind ViewModel.ChangeLanguageCommand}" CommandParameter="en-US" />
                        </StackPanel>
                        <Grid><TextBlock VerticalAlignment="Center" Text="{StaticResource Label.RunAtStartup}" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.RunAtStartup, Mode=OneWay}" Toggled="RunAtStartup_Toggled" /></Grid>
                        <Grid><TextBlock VerticalAlignment="Center" Text="{StaticResource Label.StartMinimized}" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" Toggled="Preference_Toggled" /></Grid>
                        <Grid><TextBlock VerticalAlignment="Center" Text="{StaticResource Label.AutoEco}" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.AutoEcoOnBattery, Mode=TwoWay}" Toggled="Preference_Toggled" /></Grid>
                        <Grid><TextBlock VerticalAlignment="Center" Text="{StaticResource Label.AutoRefresh}" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.AutoRefreshRate, Mode=TwoWay}" Toggled="Preference_Toggled" /></Grid>
                        <Grid><TextBlock VerticalAlignment="Center" Text="{StaticResource Label.ShowOsd}" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.ShowOsd, Mode=TwoWay}" Toggled="Preference_Toggled" /></Grid>
                        <Grid><TextBlock VerticalAlignment="Center" Text="{StaticResource Label.ShowFps}" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.ShowFps, Mode=OneWay}" Toggled="ShowFps_Toggled" /></Grid>
                        <Grid><TextBlock VerticalAlignment="Center" Text="{StaticResource Label.GlobalHotkeys}" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.EnableGlobalHotkeys, Mode=TwoWay}" Toggled="Preference_Toggled" /></Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource SectionPanelStyle}">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{StaticResource Section.DeviceSettings}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="{StaticResource Status.Writable}" />
                    </StackPanel>
                    <ItemsControl Grid.Column="1" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}" ItemsSource="{x:Bind ViewModel.DeviceSettings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="48" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsEnabled="{Binding IsWritable}" IsOn="{Binding Enabled, Mode=TwoWay}" Toggled="DeviceSetting_Toggled" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource SectionPanelStyle}">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{StaticResource Section.Services}" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource CompactIconButtonStyle}" Command="{x:Bind ViewModel.RefreshServicesCommand}" ToolTipService.ToolTip="{StaticResource Tip.Refresh}">
                                <FontIcon FontSize="15" Glyph="&#xE72C;" />
                            </Button>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="AcerService / WMI" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="14">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ManagedServices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="48" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding Name}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource PredatorAccentBrush}" Text="{StaticResource Label.Required}" Visibility="{Binding IsRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{StaticResource Label.Optional}" Visibility="{Binding IsRequired, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Status}" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{Binding StartMode}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button Foreground="{ThemeResource PredatorDangerBrush}" Content="{StaticResource Action.DisableConflicts}" Command="{x:Bind ViewModel.DisableConflictingServicesCommand}" />
                            <Button Content="{StaticResource Action.RestoreServices}" Command="{x:Bind ViewModel.RestoreConflictingServicesCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource SectionPanelStyle}">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{StaticResource Section.Diagnostics}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind ViewModel.CompatibilityMessage, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <Button Content="{StaticResource Action.OpenLogs}" Command="{x:Bind ViewModel.OpenLogsCommand}" />
                        <Button Style="{StaticResource AccentButtonStyle}" Content="{StaticResource Action.ExportDiagnostics}" Command="{x:Bind ViewModel.ExportDiagnosticsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
