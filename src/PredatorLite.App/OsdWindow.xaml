<Window
    x:Class="PredatorLite.App.OsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Border
            Margin="1"
            Padding="16,13"
            Background="{ThemeResource PredatorPaneBrush}"
            BorderBrush="{ThemeResource PredatorBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="15"
                            Foreground="{ThemeResource PredatorAccentBrush}"
                            Glyph="&#xE9D2;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PredatorTextBrush}"
                            Text="{Binding CurrentOperatingModeName}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource PredatorMutedTextBrush}"
                        Text="{Binding CurrentFanModeName}" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="CPU" />
                        <TextBlock Foreground="{ThemeResource PredatorTextBrush}" Text="{Binding CpuTemperatureText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="GPU" />
                        <TextBlock Foreground="{ThemeResource PredatorTextBrush}" Text="{Binding GpuTemperatureText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock x:Name="CpuFanLabel" Style="{StaticResource MutedTextStyle}" Text="{StaticResource Metric.CpuFan}" />
                        <TextBlock Foreground="{ThemeResource PredatorTextBrush}" Text="{Binding CpuFanText}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="3"
                        Spacing="3"
                        Visibility="{Binding ShowFps, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="FPS" />
                        <TextBlock Foreground="{ThemeResource PredatorTextBrush}" Text="{Binding FpsText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
