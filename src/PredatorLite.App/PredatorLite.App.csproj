<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PredatorLite.Core\PredatorLite.Core.csproj" />
    <ProjectReference Include="..\PredatorLite.Platform.Windows\PredatorLite.Platform.Windows.csproj" />
    <ProjectReference Include="..\PredatorLite.FanGuard\PredatorLite.FanGuard.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference
      Include="..\PredatorLite.ElevatedHelper\PredatorLite.ElevatedHelper.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
      Condition="'$(DistributionChannel)' != 'Store'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(PredatorLiteWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(PredatorLiteWindowsVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(PredatorLiteWindowsVersion)</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PredatorLiteFluent.ico</ApplicationIcon>
    <RuntimeIdentifier>$(PredatorLiteRuntimeIdentifier)</RuntimeIdentifier>
    <Platforms>$(PredatorLitePlatformTarget)</Platforms>
    <PlatformTarget>$(PredatorLitePlatformTarget)</PlatformTarget>
    <AssemblyName>PredatorLite</AssemblyName>
    <Product>PredatorLite</Product>
    <Description>Independent, unofficial PredatorSense alternative for Acer Predator devices</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DistributionChannel)' == 'Store'">
    <DefineConstants>$(DefineConstants);STORE_DISTRIBUTION</DefineConstants>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\PredatorLiteFluent.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\PredatorLiteFluent.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\Strings.zhCN.xaml" LogicalName="PredatorLite.Localization.Strings.zhCN.xml" />
    <EmbeddedResource Include="Resources\Strings.enUS.xaml" LogicalName="PredatorLite.Localization.Strings.enUS.xml" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyCompanionExecutables" AfterTargets="Build"
          Condition="'$(SkipCompanionBuildCopy)' != 'true'">
    <ItemGroup>
      <CompanionFile Include="$(MSBuildProjectDirectory)\..\PredatorLite.FanGuard\bin\$(Configuration)\$(PredatorLiteWindowsTargetFramework)\$(RuntimeIdentifier)\PredatorLite.FanGuard.*" />
      <CompanionFile
        Include="$(MSBuildProjectDirectory)\..\PredatorLite.ElevatedHelper\bin\$(Configuration)\$(PredatorLiteWindowsTargetFramework)\$(RuntimeIdentifier)\PredatorLite.ElevatedHelper.*"
        Condition="'$(DistributionChannel)' != 'Store'" />
      <StoreExcludedHelperFile
        Include="$(OutDir)PredatorLite.ElevatedHelper.*"
        Condition="'$(DistributionChannel)' == 'Store'" />
    </ItemGroup>
    <Copy SourceFiles="@(CompanionFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Delete Files="@(StoreExcludedHelperFile)" />
  </Target>

  <Target Name="IncludeStoreCompanionFilesInPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(DistributionChannel)' == 'Store' and
                     '$(StoreCompanionFilesAdded)' != 'true'">
    <PropertyGroup>
      <StoreCompanionFilesAdded>true</StoreCompanionFilesAdded>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish
        Include="$(MSBuildProjectDirectory)\..\PredatorLite.FanGuard\bin\$(Configuration)\$(PredatorLiteWindowsTargetFramework)\$(RuntimeIdentifier)\PredatorLite.FanGuard.exe">
        <RelativePath>PredatorLite.FanGuard.exe</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish
        Include="$(MSBuildProjectDirectory)\..\PredatorLite.FanGuard\bin\$(Configuration)\$(PredatorLiteWindowsTargetFramework)\$(RuntimeIdentifier)\PredatorLite.FanGuard.dll">
        <RelativePath>PredatorLite.FanGuard.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish
        Include="$(MSBuildProjectDirectory)\..\PredatorLite.FanGuard\bin\$(Configuration)\$(PredatorLiteWindowsTargetFramework)\$(RuntimeIdentifier)\PredatorLite.FanGuard.deps.json">
        <RelativePath>PredatorLite.FanGuard.deps.json</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish
        Include="$(MSBuildProjectDirectory)\..\PredatorLite.FanGuard\bin\$(Configuration)\$(PredatorLiteWindowsTargetFramework)\$(RuntimeIdentifier)\PredatorLite.FanGuard.runtimeconfig.json">
        <RelativePath>PredatorLite.FanGuard.runtimeconfig.json</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PublishReadyToRunExclude Include="BlackSharp.Core.dll" />
    <PublishReadyToRunExclude Include="DiskInfoToolkit.dll" />
    <PublishReadyToRunExclude Include="HidSharp.dll" />
    <PublishReadyToRunExclude Include="LibreHardwareMonitorLib.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Graphics.Imaging.Projection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.ML.OnnxRuntime.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Windows.AI.ContentSafety.Projection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Windows.AI.Foundation.Projection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Windows.AI.Imaging.Projection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Windows.AI.MachineLearning.Projection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Windows.AI.Projection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Windows.AI.Text.Projection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Windows.AI.Video.Projection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Windows.Widgets.Projection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.WindowsAppRuntime.Bootstrap.Net.dll" />
    <PublishReadyToRunExclude Include="Mono.Posix.NETStandard.dll" />
    <PublishReadyToRunExclude Include="RAMSPDToolkit-NDD.dll" />
    <PublishReadyToRunExclude Include="System.IO.Ports.dll" />
    <PublishReadyToRunExclude Include="System.Numerics.Tensors.dll" />
  </ItemGroup>

  <Target Name="SuppressFrameworkProvidedWindowsMlNativePublishAssets"
          BeforeTargets="_ResolveCopyLocalAssetsForPublish;GeneratePublishDependencyFile"
          DependsOnTargets="ResolveLockFileCopyLocalFiles"
          Condition="'$(SelfContained)' != 'true' and
                     '$(WindowsAppSDKSelfContained)' != 'true' and
                     '$(MicrosoftWindowsAppSDKPackageDir)' != ''">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning' and
                                          '%(ReferenceCopyLocalPaths.AssetType)' == 'native'" />
      <_ResolvedCopyLocalBuildAssets Remove="@(_ResolvedCopyLocalBuildAssets)"
                                     Condition="'%(_ResolvedCopyLocalBuildAssets.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning' and
                                                '%(_ResolvedCopyLocalBuildAssets.AssetType)' == 'native'" />
    </ItemGroup>
  </Target>

  <Target Name="CopyWinUiResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WinUiPublishFile
        Include="$(OutDir)**\*.xbf"
        Exclude="$(OutDir)AppX\**\*;$(PublishDir)**\*" />
    </ItemGroup>
    <MakeDir Directories="@(WinUiPublishFile->'$(PublishDir)%(RecursiveDir)')" />
    <Copy SourceFiles="@(WinUiPublishFile)"
          DestinationFiles="@(WinUiPublishFile->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)PredatorLite.pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
