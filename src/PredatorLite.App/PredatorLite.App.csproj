<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PredatorLite.Core\PredatorLite.Core.csproj" />
    <ProjectReference Include="..\PredatorLite.Platform.Windows\PredatorLite.Platform.Windows.csproj" />
    <ProjectReference Include="..\PredatorLite.FanGuard\PredatorLite.FanGuard.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PredatorLite.ElevatedHelper\PredatorLite.ElevatedHelper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PredatorLite.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PredatorLite</AssemblyName>
    <Product>PredatorLite</Product>
    <Description>Lightweight Acer Predator PHN16-71 control utility</Description>
    <Version>0.1.0</Version>
    <CompanionTargetFramework>net10.0-windows10.0.19041.0</CompanionTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\PredatorLite.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\PredatorLite.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyCompanionExecutables" AfterTargets="Build">
    <ItemGroup>
      <CompanionFile Include="$(MSBuildProjectDirectory)\..\PredatorLite.FanGuard\bin\$(Configuration)\$(CompanionTargetFramework)\$(RuntimeIdentifier)\PredatorLite.FanGuard.*" />
      <CompanionFile Include="$(MSBuildProjectDirectory)\..\PredatorLite.ElevatedHelper\bin\$(Configuration)\$(CompanionTargetFramework)\$(RuntimeIdentifier)\PredatorLite.ElevatedHelper.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CompanionFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCompanionExecutablesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <CompanionPublishFile Include="$(MSBuildProjectDirectory)\..\PredatorLite.FanGuard\bin\$(Configuration)\$(CompanionTargetFramework)\$(RuntimeIdentifier)\PredatorLite.FanGuard.*" />
      <CompanionPublishFile Include="$(MSBuildProjectDirectory)\..\PredatorLite.ElevatedHelper\bin\$(Configuration)\$(CompanionTargetFramework)\$(RuntimeIdentifier)\PredatorLite.ElevatedHelper.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CompanionPublishFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWinUiResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WinUiPublishFile Include="$(OutDir)**\*.xbf" />
    </ItemGroup>
    <MakeDir Directories="@(WinUiPublishFile->'$(PublishDir)%(RecursiveDir)')" />
    <Copy
        SourceFiles="@(WinUiPublishFile)"
        DestinationFiles="@(WinUiPublishFile->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true" />
    <Copy
        SourceFiles="$(OutDir)PredatorLite.pri"
        DestinationFolder="$(PublishDir)"
        SkipUnchangedFiles="true" />
  </Target>

</Project>
