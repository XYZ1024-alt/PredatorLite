<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PredatorLite.Core\PredatorLite.Core.csproj" />
    <ProjectReference Include="..\PredatorLite.Platform.Windows\PredatorLite.Platform.Windows.csproj" />
    <ProjectReference Include="..\PredatorLite.FanGuard\PredatorLite.FanGuard.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\PredatorLite.ElevatedHelper\PredatorLite.ElevatedHelper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PredatorLite</AssemblyName>
    <Product>PredatorLite</Product>
    <Description>Lightweight Acer Predator PHN16-71 control utility</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <Target Name="CopyCompanionExecutables" AfterTargets="Build">
    <ItemGroup>
      <CompanionFile Include="$(MSBuildProjectDirectory)\..\PredatorLite.FanGuard\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\PredatorLite.FanGuard.*" />
      <CompanionFile Include="$(MSBuildProjectDirectory)\..\PredatorLite.ElevatedHelper\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\PredatorLite.ElevatedHelper.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CompanionFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeCompanionAssembliesInPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\PredatorLite.FanGuard\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\PredatorLite.FanGuard.dll">
        <RelativePath>PredatorLite.FanGuard.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\PredatorLite.FanGuard\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\PredatorLite.FanGuard.pdb">
        <RelativePath>PredatorLite.FanGuard.pdb</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\PredatorLite.ElevatedHelper\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\PredatorLite.ElevatedHelper.dll">
        <RelativePath>PredatorLite.ElevatedHelper.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\PredatorLite.ElevatedHelper\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\PredatorLite.ElevatedHelper.pdb">
        <RelativePath>PredatorLite.ElevatedHelper.pdb</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
