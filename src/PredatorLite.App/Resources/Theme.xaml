            <StaticResource x:Key="SemanticSuccessBackgroundBrush" ResourceKey="SystemFillColorSuccessBackgroundBrush" />
            <StaticResource x:Key="SemanticCautionBrush" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="SemanticCautionBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="SemanticCriticalBrush" ResourceKey="SystemFillColorCriticalBrush" />
            <StaticResource x:Key="SemanticCriticalBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
