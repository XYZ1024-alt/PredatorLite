        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppCaptionButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="Template" Value="{StaticResource TitleBarCaptionButtonTemplate}" />
    </Style>

    <Style
        x:Key="TitleBarCloseCaptionButtonStyle"
        BasedOn="{StaticResource TitleBarCaptionButtonStyle}"
        TargetType="Button">
        <Setter Property="Template" Value="{StaticResource TitleBarCloseCaptionButtonTemplate}" />
    </Style>

