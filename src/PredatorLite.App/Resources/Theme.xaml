<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PredatorLite.App.Converters">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="PredatorWindowBrush" Color="#101416" />
            <SolidColorBrush x:Key="PredatorPaneBrush" Color="#B813181B" />
            <SolidColorBrush x:Key="PredatorSurfaceBrush" Color="#C21B2125" />
            <SolidColorBrush x:Key="PredatorSurfaceSecondaryBrush" Color="#90242B30" />
            <SolidColorBrush x:Key="PredatorBorderBrush" Color="#593B454B" />
            <SolidColorBrush x:Key="PredatorTextBrush" Color="#F4F7F8" />
            <SolidColorBrush x:Key="PredatorMutedTextBrush" Color="#A7B1B6" />
            <SolidColorBrush x:Key="PredatorAccentBrush" Color="#72DC87" />
            <SolidColorBrush x:Key="PredatorAccentSubtleBrush" Color="#382A6B39" />
            <SolidColorBrush x:Key="PredatorCyanBrush" Color="#52C7E8" />
            <SolidColorBrush x:Key="PredatorWarningBrush" Color="#FFB454" />
            <SolidColorBrush x:Key="PredatorDangerBrush" Color="#FF7373" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PredatorWindowBrush" Color="#F3F6F7" />
            <SolidColorBrush x:Key="PredatorPaneBrush" Color="#DDF7F9FA" />
            <SolidColorBrush x:Key="PredatorSurfaceBrush" Color="#EFFFFFFF" />
            <SolidColorBrush x:Key="PredatorSurfaceSecondaryBrush" Color="#C9E7ECEE" />
            <SolidColorBrush x:Key="PredatorBorderBrush" Color="#463C4A50" />
            <SolidColorBrush x:Key="PredatorTextBrush" Color="#172024" />
            <SolidColorBrush x:Key="PredatorMutedTextBrush" Color="#5C6A71" />
            <SolidColorBrush x:Key="PredatorAccentBrush" Color="#197A37" />
            <SolidColorBrush x:Key="PredatorAccentSubtleBrush" Color="#1E197A37" />
            <SolidColorBrush x:Key="PredatorCyanBrush" Color="#087C9C" />
            <SolidColorBrush x:Key="PredatorWarningBrush" Color="#9B5700" />
            <SolidColorBrush x:Key="PredatorDangerBrush" Color="#B4232A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PredatorWindowBrush" Color="Black" />
            <SolidColorBrush x:Key="PredatorPaneBrush" Color="Black" />
            <SolidColorBrush x:Key="PredatorSurfaceBrush" Color="Black" />
            <SolidColorBrush x:Key="PredatorSurfaceSecondaryBrush" Color="Black" />
            <SolidColorBrush x:Key="PredatorBorderBrush" Color="White" />
            <SolidColorBrush x:Key="PredatorTextBrush" Color="White" />
            <SolidColorBrush x:Key="PredatorMutedTextBrush" Color="White" />
            <SolidColorBrush x:Key="PredatorAccentBrush" Color="Yellow" />
            <SolidColorBrush x:Key="PredatorAccentSubtleBrush" Color="Black" />
            <SolidColorBrush x:Key="PredatorCyanBrush" Color="Cyan" />
            <SolidColorBrush x:Key="PredatorWarningBrush" Color="Yellow" />
            <SolidColorBrush x:Key="PredatorDangerBrush" Color="Red" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
    <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PredatorTextBrush}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PredatorTextBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource PredatorMutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="0,18,0,20" />
        <Setter Property="BorderBrush" Value="{ThemeResource PredatorBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="MetricTileStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{ThemeResource PredatorSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PredatorBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="ToolPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{ThemeResource PredatorSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PredatorBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="CompactIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{ThemeResource PredatorBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
